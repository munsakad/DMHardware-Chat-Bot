563,Robotics,Robotics,Encoders & Speed Measurement — Counting pulses with interrupts [2abe0bbc],"const int ENCODER_A = 2;   // must be an interrupt-capable pin
const int ENCODER_B = 4;
volatile long encoderCount = 0;

void encoderISR() {
    if (digitalRead(ENCODER_B) == HIGH) {
        encoderCount++;
    } else {
        encoderCount--;
    }
}

void setup() {
    pinMode(ENCODER_A, INPUT_PULLUP);
    pinMode(ENCODER_B, INPUT_PULLUP);
    attachInterrupt(digitalPinToInterrupt(ENCODER_A), encoderISR, RISING);
}",robotics;encoders-and-speed-measurement;code,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=encoders-and-speed-measurement,lesson:robotics/encoders-and-speed-measurement,code
564,Robotics,Robotics,Encoders & Speed Measurement — Counting pulses with interrupts [45c21388],"This follows the same interrupt-service-routine rules covered in the Arduino course: the ISR does the minimum possible work (checking pin B and incrementing or decrementing a volatile counter), leaving anything more involved to loop().",robotics;encoders-and-speed-measurement;lesson_passage,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=encoders-and-speed-measurement,lesson:robotics/encoders-and-speed-measurement,lesson_passage
565,Robotics,Robotics,Encoders & Speed Measurement — Converting pulse counts to distance and speed [9761b365],"const int PULSES_PER_REV = 20;      // encoder disc slots
const float WHEEL_DIAMETER = 0.065;  // meters
const float WHEEL_CIRCUMFERENCE = PI * WHEEL_DIAMETER;

float pulsesToDistance(long pulses) {
    return (pulses / (float)PULSES_PER_REV) * WHEEL_CIRCUMFERENCE;
}

long lastCount = 0;
unsigned long lastSpeedTime = 0;

float getWheelSpeed() {
    long currentCount = encoderCount;
    unsigned long currentTime = millis();

    float distance = pulsesToDistance(currentCount - lastCount);
    float dt = (currentTime - lastSpeedTime) / 1000.0;

    lastCount = currentCount;
    lastSpeedTime = currentTime;

    return distance / dt;   // meters per second
}",robotics;encoders-and-speed-measurement;code,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=encoders-and-speed-measurement,lesson:robotics/encoders-and-speed-measurement,code
566,Robotics,Robotics,Encoders & Speed Measurement — Converting pulse counts to distance and speed [ac33a95b],"Feeding this measured speed (rather than a commanded PWM value) into the odometry equations from the Kinematics & Odometry lesson produces a far more accurate position estimate, and feeding it into the PID controller from later in this course is what makes true closed-loop speed control possible.",robotics;encoders-and-speed-measurement;lesson_passage,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=encoders-and-speed-measurement,lesson:robotics/encoders-and-speed-measurement,lesson_passage
567,Robotics,Robotics,Ultrasonic & IR Distance Sensing — Ultrasonic distance sensing (HC-SR04) [f8c91a99],"An ultrasonic sensor sends a burst of sound and measures how long the echo takes to return; since sound travels at a known, roughly constant speed through air, that time directly gives distance.",robotics;ultrasonic-and-ir-distance-sensing;lesson_passage,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=ultrasonic-and-ir-distance-sensing,lesson:robotics/ultrasonic-and-ir-distance-sensing,lesson_passage
568,Robotics,Robotics,Ultrasonic & IR Distance Sensing — Ultrasonic distance sensing (HC-SR04) [1deacbe8],"const int TRIG_PIN = 7;
const int ECHO_PIN = 8;

float readDistanceCm() {
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);
    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN, LOW);

    long durationUs = pulseIn(ECHO_PIN, HIGH, 30000);   // timeout after 30 ms (~5 m range)
    if (durationUs == 0) return -1;                       // no echo received

    return (durationUs * 0.0343) / 2.0;   // speed of sound ≈ 343 m/s = 0.0343 cm/µs
}

void setup() {
    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);
    Serial.begin(9600);
}

void loop() {
    Serial.println(readDistanceCm());
    delay(100);
}",robotics;ultrasonic-and-ir-distance-sensing;code,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=ultrasonic-and-ir-distance-sensing,lesson:robotics/ultrasonic-and-ir-distance-sensing,code
