584,Robotics,Robotics,Line-Following Robots — Steering with proportional control [659bc9b9],"const int BASE_SPEED = 150;
const float KP = 40.0;

void loop() {
    readSensors();
    float error = getLineError();

    int correction = (int)(KP * error);
    int leftSpeed  = constrain(BASE_SPEED + correction, 0, 255);
    int rightSpeed = constrain(BASE_SPEED - correction, 0, 255);

    setMotor(LEFT_IN1, LEFT_IN2, LEFT_EN, leftSpeed);
    setMotor(RIGHT_IN1, RIGHT_IN2, RIGHT_EN, rightSpeed);
}",robotics;line-following-robots;code,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=line-following-robots,lesson:robotics/line-following-robots,code
585,Robotics,Robotics,Line-Following Robots — Steering with proportional control [5ae0cdd3],"This is a proportional (P) controller, the simplest member of the PID family covered in depth later in this course -- the steering correction scales directly with how far off-center the line is. Adding integral and derivative terms (once PID has been covered) typically makes line following noticeably smoother and lets the robot handle sharper corners at higher speed.",robotics;line-following-robots;lesson_passage,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=line-following-robots,lesson:robotics/line-following-robots,lesson_passage
586,Robotics,Robotics,Obstacle Avoidance Algorithms — Reactive avoidance: a simple decision loop [240d12dc],"const int FRONT_THRESHOLD_CM = 20;

void loop() {
    float distance = readDistanceCm();   // from the Distance Sensing lesson

    if (distance > 0 && distance < FRONT_THRESHOLD_CM) {
        setMotor(LEFT_IN1, LEFT_IN2, LEFT_EN, 0);
        setMotor(RIGHT_IN1, RIGHT_IN2, RIGHT_EN, 0);
        delay(200);

        setMotor(LEFT_IN1, LEFT_IN2, LEFT_EN, -150);   // reverse briefly
        setMotor(RIGHT_IN1, RIGHT_IN2, RIGHT_EN, -150);
        delay(300);

        setMotor(LEFT_IN1, LEFT_IN2, LEFT_EN, -150);   // spin to turn away
        setMotor(RIGHT_IN1, RIGHT_IN2, RIGHT_EN, 150);
        delay(400);
    } else {
        setMotor(LEFT_IN1, LEFT_IN2, LEFT_EN, 150);    // drive forward
        setMotor(RIGHT_IN1, RIGHT_IN2, RIGHT_EN, 150);
    }
}",robotics;obstacle-avoidance-algorithms;code,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=obstacle-avoidance-algorithms,lesson:robotics/obstacle-avoidance-algorithms,code
587,Robotics,Robotics,Obstacle Avoidance Algorithms — Reactive avoidance: a simple decision loop [254bc5f6],"This ""stop, back up, turn"" sequence is simple and works reasonably well, but it is entirely reactive -- the robot has no memory of where it has already been and no real plan, so it can occasionally get stuck oscillating between two obstacles.",robotics;obstacle-avoidance-algorithms;lesson_passage,https://munsakad.github.io/Hardware-Engineering-Education-Hub/pages/course.html?slug=robotics&lesson=obstacle-avoidance-algorithms,lesson:robotics/obstacle-avoidance-algorithms,lesson_passage
